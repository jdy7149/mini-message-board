<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'The board' }) %>
  </head>
  <body>
    <div class="page">
      <%- include('partials/header') %>
      <main>
        <section class="intro">
          <p class="eyebrow">A little space to connect</p>
          <h1>Small messages.<br />Good company.</h1>
          <p class="subtitle">
            Say hello, share a thought, or leave a little something for the next
            person.
          </p>
        </section>
        <section aria-labelledby="messages-heading">
          <div class="section-heading">
            <h2 id="messages-heading">
              On the board <span class="count"><%= messages.length %></span>
            </h2>
            <span class="section-note">A few words go a long way.</span>
          </div>
          <div class="message-grid">
            <% messages.forEach(({ text, user, added }, i) => { %>
            <article class="message-card">
              <div class="author">
                <span class="avatar" aria-hidden="true"
                  ><%= (user || '?').charAt(0).toUpperCase() %></span
                ><span><%= user %></span>
              </div>
              <p class="message-text"><%= text %></p>
              <div class="card-footer">
                <time datetime="<%= added.toISOString() %>"
                  ><%= added.toLocaleDateString('en-US', { month: 'short', day:
                  'numeric', year: 'numeric' }) %></time
                ><a
                  class="text-link"
                  href="/detail/<%= i %>"
                  aria-label="Open message from <%= user %>"
                  >Open message ↗</a
                >
              </div>
            </article>
            <% }) %>
          </div>
          <% if (!messages.length) { %>
          <p class="empty-state">
            The board is quiet. <a href="/new">Leave the first message.</a>
          </p>
          <% } %>
        </section>
      </main>
      <footer>A small board. A shared space.</footer>
    </div>
  </body>
</html>
